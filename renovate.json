{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "github>rdartus/home-ops//.renovate/packageRules.json"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 25,
  "branchConcurrentLimit": 25,
  "prCreation": "immediate",
  "suppressNotifications": [
    "prEditedNotification",
    "prIgnoreNotification"
  ],
  "ignorePaths": [
    "**/.vscode/**",
    "**/_archive/**"
  ],
  "enabledManagers": [
    "flux",
    "kubernetes",
    "helm-values",
    "dockerfile",
    "custom.regex"
  ],
  "flux": {
    "managerFilePatterns": [
      "/(^|/)kubernetes/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)kubernetes/.+\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)kubernetes/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Version Talos OS — talconfig.yaml + tag d'image dans les patches par nœud",
      "managerFilePatterns": [
        "/(^|/)talos/talconfig\\.yaml$/",
        "/(^|/)talos/patches/.+\\.yaml$/"
      ],
      "matchStrings": [
        "talosVersion:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)",
        "image:\\s*factory\\.talos\\.dev/[^:\\s]+:(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "talos",
      "packageNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Version Kubernetes — talconfig.yaml",
      "managerFilePatterns": [
        "/(^|/)talos/talconfig\\.yaml$/"
      ],
      "matchStrings": [
        "kubernetesVersion:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "kubernetes",
      "packageNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}